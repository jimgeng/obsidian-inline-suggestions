{
  "name": "obsidian-inline-suggestions",
  "version": "0.1.0",
  "private": true,
  "description": "Inline Markdown suggestions for Obsidian.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "mocha": "^12.0.3",
    "obsidian": "1.13.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
